{
  "meta": {
    "name": "BOM 风险物料识别规则库",
    "version": "1.0",
    "description": "缺货(STOCKOUT)/停产(EOL)/交期超期(LEAD_TIME) 三类风险的判定规则与级别划分。条件表达式由 rule_engine 求值, 变量路径 mat.* 指向物料字段。"
  },
  "lead_time_threshold_days": 30,
  "level_order": {"high": 0, "medium": 1, "low": 2},
  "level_labels": {"high": "高", "medium": "中", "low": "低"},
  "rules": [
    {
      "rule_id": "R-STK-01",
      "risk_type": "STOCKOUT",
      "risk_type_name": "缺货",
      "name": "库存低于安全库存",
      "condition": {"op": "lt", "left": "mat.stock_qty", "right": "mat.safety_stock"},
      "levels": [
        {
          "level": "high",
          "label": "严重缺货",
          "condition": {"op": "lt", "left": "mat.stock_qty",
                        "right": {"op": "mul", "args": [{"op": "ref", "path": "mat.safety_stock"}, 0.5]}},
          "msg": "库存仅为安全库存的 {pct}%, 随时可能断供"
        },
        {
          "level": "medium",
          "label": "中度缺货",
          "condition": {"op": "lt", "left": "mat.stock_qty",
                        "right": {"op": "mul", "args": [{"op": "ref", "path": "mat.safety_stock"}, 0.8]}},
          "msg": "库存为安全库存的 {pct}%, 低于 80% 警戒线"
        },
        {
          "level": "low",
          "label": "轻度缺货",
          "condition": null,
          "msg": "库存为安全库存的 {pct}%, 低于 100% 但高于 80%"
        }
      ],
      "fields": {"actual": "mat.stock_qty", "threshold": "mat.safety_stock"}
    },
    {
      "rule_id": "R-EOL-01",
      "risk_type": "EOL",
      "risk_type_name": "停产",
      "name": "物料已停产(End of Life)",
      "condition": {"op": "eq", "left": "mat.lifecycle_status", "right": "EOL"},
      "levels": [
        {
          "level": "high",
          "label": "已停产",
          "condition": null,
          "msg": "物料已停产, 供应中断, 必须尽快寻找替代"
        }
      ],
      "fields": {"actual": "mat.lifecycle_status"}
    },
    {
      "rule_id": "R-EOL-02",
      "risk_type": "EOL",
      "risk_type_name": "停产",
      "name": "物料即将停产(Phase-out)",
      "condition": {"op": "eq", "left": "mat.lifecycle_status", "right": "phaseout"},
      "levels": [
        {
          "level": "medium",
          "label": "即将停产",
          "condition": null,
          "msg": "厂商已发布停产预告, 建议提前规划替代物料"
        }
      ],
      "fields": {"actual": "mat.lifecycle_status"}
    },
    {
      "rule_id": "R-LT-01",
      "risk_type": "LEAD_TIME",
      "risk_type_name": "交期超期",
      "name": "采购交期超过阈值",
      "condition": {"op": "gt", "left": "mat.lead_time_days",
                    "right": {"op": "ref", "path": "cfg.lead_time_threshold_days"}},
      "levels": [
        {
          "level": "high",
          "label": "交期严重超期",
          "condition": {"op": "gt", "left": "mat.lead_time_days",
                        "right": {"op": "mul", "args": [{"op": "ref", "path": "cfg.lead_time_threshold_days"}, 2]}},
          "msg": "交期 {actual} 天, 超过阈值 {threshold} 天的 2 倍, 严重影响生产计划"
        },
        {
          "level": "medium",
          "label": "交期中度超期",
          "condition": {"op": "gt", "left": "mat.lead_time_days",
                        "right": {"op": "mul", "args": [{"op": "ref", "path": "cfg.lead_time_threshold_days"}, 1.5]}},
          "msg": "交期 {actual} 天, 为阈值 {threshold} 天的 1.5~2 倍"
        },
        {
          "level": "low",
          "label": "交期轻度超期",
          "condition": null,
          "msg": "交期 {actual} 天, 略超阈值 {threshold} 天"
        }
      ],
      "fields": {"actual": "mat.lead_time_days", "threshold": "cfg.lead_time_threshold_days"}
    }
  ]
}
