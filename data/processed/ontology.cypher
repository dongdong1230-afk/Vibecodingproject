CREATE (r_R-CAT-01:Rule {rule_id: "R-CAT-01", name: "同小类可替代", then: "allow", swrl: "Material(?c) ∧ Material(?o) ∧ hasCategory(?c,?k) ∧ hasCategory(?o,?k) → CanSubstitute(?c,?o)"});
CREATE (r_R-COND-01:Rule {rule_id: "R-COND-01", name: "高温工况 X5R 不可替代 X7R", then: "deny", swrl: "WorkCond(?w) ∧ hasTempGrade(?w,高温) ∧ hasDielectric(?o,X7R) ∧ hasDielectric(?c,X5R) → ¬CanSubstitute(?c,?o)"});
CREATE (r_R-COND-01)-[:APPLIES_TO]->(c_CAT_CAP_MLCC);
CREATE (r_R-COND-02:Rule {rule_id: "R-COND-02", name: "高温工况 NBR 不可替代 FKM 密封圈", then: "deny", swrl: "WorkCond(?w) ∧ hasTempGrade(?w,高温) ∧ hasMaterial(?o,FKM) ∧ hasMaterial(?c,NBR) → ¬CanSubstitute(?c,?o)"});
CREATE (r_R-COND-02)-[:APPLIES_TO]->(c_CAT_SEAL_ORING);
CREATE (r_R-COND-03:Rule {rule_id: "R-COND-03", name: "潮湿环境镀锌螺栓不可替代达克罗", then: "deny", swrl: "WorkCond(?w) ∧ hasEnv(?w,潮湿) ∧ hasSurface(?o,达克罗) ∧ hasSurface(?c,镀锌) → ¬CanSubstitute(?c,?o)"});
CREATE (r_R-COND-03)-[:APPLIES_TO]->(c_CAT_BOLT);
CREATE (r_R-COND-04:Rule {rule_id: "R-COND-04", name: "振动环境含油轴承风机不可替代滚珠风机", then: "deny", swrl: "WorkCond(?w) ∧ hasEnv(?w,振动) ∧ hasBearing(?o,滚珠) ∧ hasBearing(?c,含油) → ¬CanSubstitute(?c,?o)"});
CREATE (r_R-COND-04)-[:APPLIES_TO]->(c_CAT_FAN_AXIAL);
CREATE (r_R-COND-05:Rule {rule_id: "R-COND-05", name: "低温工况 C0G 不可替代 X7R", then: "deny", swrl: "WorkCond(?w) ∧ hasTempGrade(?w,低温) ∧ hasDielectric(?o,C0G) ∧ hasDielectric(?c,X7R) → ¬CanSubstitute(?c,?o)"});
CREATE (r_R-COND-05)-[:APPLIES_TO]->(c_CAT_CAP_MLCC);
CREATE (r_R-QUAL-01:Rule {rule_id: "R-QUAL-01", name: "故障率质量底线", then: "deny", swrl: "Material(?c) ∧ Material(?o) ∧ hasFailureRate(?c,?fc) ∧ hasFailureRate(?o,?fo) ∧ swrlb:greaterThan(?fc, multiply(?fo,3)) → ¬CanSubstitute(?c,?o)"});
CREATE (r_R-PRICE-01:Rule {rule_id: "R-PRICE-01", name: "替代成本上限约束", then: "warn", swrl: "Material(?c) ∧ Material(?o) ∧ hasPrice(?c,?pc) ∧ hasPrice(?o,?po) ∧ swrlb:greaterThan(?pc, multiply(?po,1.5)) → CostWarning(?c,?o)"});
CREATE (r_R-LT-01:Rule {rule_id: "R-LT-01", name: "替代交期不劣化约束", then: "warn", swrl: "Material(?c) ∧ Material(?o) ∧ hasLeadTime(?c,?lc) ∧ hasLeadTime(?o,?lo) ∧ swrlb:greaterThan(?lc, multiply(?lo,2)) → LeadTimeWarning(?c,?o)"});
CREATE (c_CAT_CAP_ALU)-[:FORBID_SUBSTITUTE {rule_id: "FP-001"}]->(c_CAT_CAP_TANT);
CREATE (c_CAT_CAP_MLCC)-[:FORBID_SUBSTITUTE {rule_id: "FP-002"}]->(c_CAT_CAP_TANT);
